    "journal_border": "$shadow",
    "pane_border": "$shadow",
    "tab_border": "$shadow",
    "group_border": "$shadow",
    "preview_border": "$shadow",
    "active_border": "$shadow",
    "legacy_scrollbar": "$shadow",
