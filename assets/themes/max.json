    "community_border": "#4e8a5d",
    "community_hover_border": "#78b68a",
    "disabled_text": "#81796e",
    "community_disabled_text": "#928f86",
    "checkbox_border": "#a29684",
    "donate_background": "#a35d2c",
    "checkbox_hover_border": "#ffd09a",
    "status_button_text": "#fff3dc",
    "mini_ready_background": "#356b42",
    "disabled_border": "#39352f",
    "mini_ready_hover": "#427e50",
    "checking_background": "#685735",
    "mini_ready_border": "#78a780",
    "setup_background": "#805f35",
    "issue_background": "#864f3b",
    "mini_error_background": "#873c38",
    "mini_warning_background": "#945b27",
    "mini_error_hover": "#a04842",
    "mini_warning_hover": "#aa6b30",
    "donate_hover": "#b56b34",
    "mini_error_border": "#d17a70",
