    "log_system": "#bea5ff",
    "log_success": "#78e196",
    "log_warning": "#ffc350",
    "log_error": "#ff7d7d",
    "support_link": "#efa35c",
    "log_debug": "#bebe8c",
    "log_badge_text": "#29232c",
    "scrollbar_thumb": {
      "mix": [
        "$window",
        "$windowText",
        0.55
      ]
