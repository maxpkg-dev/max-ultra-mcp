    "hilight": "#666666",
    "itemHilight": "#705137",
    "hilightText": "#ffffff",
    "rollupTitleFace": "#515151",
    "rollupTitleText": "#e1e1e1"
  },
  "light_colors": {
    "log_info": "#236270",
    "log_system": "#683c9b",
    "log_success": "#246d37",
    "log_warning": "#895100",
    "log_error": "#a52a2a",
    "support_link": "#9c4c00",
    "log_debug": "#626222",
    "log_badge_text": "#ffffff"
