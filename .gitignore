# Local per-install runtime state. Never commit control tokens or ownership data.
runtime/state/
runtime/win-x64/

# MaxPkg Packager tooling, machine-local settings, and generated release output.
maxpkg-packager.ini
maxpkg-changelog.ini
dist/
/temp

# Python bytecode belongs to the active Max runtime, never the package.
__pycache__/
*.pyc
